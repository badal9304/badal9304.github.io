---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import { bio, skills, experience, recognition, tools, education } from '../data/experience';
---

<BaseLayout title={`About, ${site.name}`} description="Background, skills and experience of Badal Ranjan, UI/UX Designer.">
  <div class="wrap">
    <header class="page-head">
      <p class="eyebrow">About me</p>
      <h1>Clear thinking, deliberate decisions.</h1>
    </header>

    <section class="about-block" aria-labelledby="bg">
      <h2 id="bg">Background</h2>
      <div class="bio">
        {bio.map((p) => <p>{p}</p>)}
      </div>
    </section>

    <section class="about-block" aria-labelledby="skills">
      <h2 id="skills">Skills and expertise</h2>
      <div class="skill-grid">
        {
          skills.map((s) => (
            <div class="skill">
              <h3>{s.group}</h3>
              <ul>{s.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))
        }
      </div>
    </section>

    <section class="about-block" aria-labelledby="exp">
      <h2 id="exp">Experience</h2>
      <ol class="timeline">
        {
          experience.map((job) => (
            <li class="job">
              <p class="period">{job.period}</p>
              <div>
                <h3>{job.role}</h3>
                <p class="job-company">{job.company}{job.client && <span>, {job.client} client</span>}</p>
                <p class="summary">{job.summary}</p>
                {job.points.length > 0 && <ul>{job.points.map((pt) => <li>{pt}</li>)}</ul>}
              </div>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="about-block" aria-labelledby="tools">
      <h2 id="tools">Tools</h2>
      <dl class="rows">{tools.map((t) => <div><dt>{t.group}</dt><dd>{t.items}</dd></div>)}</dl>
    </section>

    <section class="about-block" aria-labelledby="rec">
      <h2 id="rec">Recognition</h2>
      <dl class="rows">{recognition.map((r) => <div><dt>{r.year}</dt><dd>{r.text}</dd></div>)}</dl>
    </section>

    <section class="about-block" aria-labelledby="edu">
      <h2 id="edu">Education</h2>
      <dl class="rows">{education.map((e) => <div><dt>{e.year}</dt><dd>{e.text}</dd></div>)}</dl>
    </section>

    <div class="about-cta">
      <a class="btn btn-primary" href="/#work">See selected work</a>
      <a class="btn" href="#contact">Get in touch</a>
    </div>
  </div>
</BaseLayout>
