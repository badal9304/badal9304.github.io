---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkGrid from '../components/WorkGrid.astro';
import { site } from '../data/site';
import { personSchema, websiteSchema } from '../data/schema';

const schema = [{ '@context': 'https://schema.org', ...personSchema }, websiteSchema];
---

<BaseLayout schema={schema}>
  <section class="hero wrap" aria-labelledby="hero-title">
    <p class="eyebrow">{site.eyebrow}</p>
    <h1 class="hero-title" id="hero-title">
      {site.headline.map((line) => <span class="line"><span>{line}</span></span>)}
    </h1>
    <div class="hero-meta">
      <div>
        <div class="intro">
          {site.intro.map((p) => <p>{p}</p>)}
        </div>
        <div class="actions">
          <a class="btn btn-primary" href="#work">See selected work</a>
          {site.resume && <a class="btn" href={site.resume} download="Badal-Ranjan-CV.pdf">Download CV <span class="sr-only">(PDF)</span></a>}
        </div>
        <ul class="hero-links">
          <li><a href="/about/">About me</a></li>
          {site.links.filter((l) => l.label === 'LinkedIn').map((l) => <li><a href={l.href} rel="noopener" target="_blank">{l.label}<span class="sr-only"> (opens in a new tab)</span></a></li>)}
          <li><a href="#contact">Get in touch</a></li>
        </ul>
      </div>
      <dl class="now">
        {site.timeline.map((t) => <div><dt>{t.label}</dt><dd><span class="company">{t.company}</span><span class="muted">{t.text}</span></dd></div>)}
      </dl>
    </div>
  </section>

  <section class="work wrap" id="work" aria-labelledby="work-title">
    <div class="section-head">
      <h2 id="work-title">Selected work</h2>
      <p class="section-note">Mobile, fintech, enterprise and travel products, from research to high-fidelity design.</p>
    </div>
    <WorkGrid />
  </section>

  <section class="principles wrap" aria-labelledby="principles-title">
    <div class="section-head">
      <h2 id="principles-title">How I work</h2>
    </div>
    <ol class="principle-list">
      {
        site.principles.map((p) => (
          <li>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))
      }
    </ol>
  </section>
</BaseLayout>
