---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found | Badal Ranjan"
  description="This page doesn’t exist or has moved. Go back to Badal Ranjan’s UI/UX design portfolio to see case studies, background, skills and contact details."
  noindex
>
  <section class="wrap page-head" aria-labelledby="nf-title">
    <p class="eyebrow">Error 404</p>
    <h1 id="nf-title">This page doesn’t exist.</h1>
    <p class="lede">The link may be out of date, or the address may have a typo.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/">Go to the home page</a>
      <a class="btn" href="/#work">See selected work</a>
    </div>
  </section>
</BaseLayout>
