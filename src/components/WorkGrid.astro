---
// The work section: one featured case study, supporting case studies, then a short list of other work.
import Cover from './Cover.astro';
import { projects, tones } from '../data/projects';

const featured = projects.find((p: any) => p.group === 'featured');
const selected = projects.filter((p: any) => p.group === 'selected');
const more = projects.filter((p: any) => p.group === 'more');
---

{
  featured && (
    <article class="featured">
      <a href={featured.url} class="featured-link">
        <Cover project={featured} eager tone="var(--tone-1)" />
        <div class="featured-body">
          <p class="eyebrow">Featured · {featured.category}</p>
          <h3>{featured.title}</h3>
          <p class="featured-headline">{featured.headline}</p>
          {featured.contributions && (
            <ul class="tags" aria-label="Areas of contribution">
              {featured.contributions.map((c: string) => <li>{c}</li>)}
            </ul>
          )}
          <span class="arrow-link">Read the case study</span>
        </div>
      </a>
    </article>
  )
}

<ul class="work-grid">
  {
    selected.map((p: any, i: number) => (
      <li class="project">
        <a href={p.url}>
          <Cover project={p} tone={tones[(i + 1) % tones.length]} />
          <p class="eyebrow">{p.category}</p>
          <h3>{p.title}</h3>
          <p class="summary">{p.summary}</p>
          <span class="arrow-link">View project</span>
        </a>
      </li>
    ))
  }
</ul>

{
  more.length > 0 && (
    <div class="more-work">
      <h3 class="more-head">More work</h3>
      <ul>
        {more.map((p: any) => (
          <li>
            <a href={p.url}>
              <span class="more-title">{p.title}</span>
              <span class="more-cat">{p.category}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  )
}
