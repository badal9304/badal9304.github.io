---
import BaseLayout from './BaseLayout.astro';
import Cover from '../components/Cover.astro';
import { projects } from '../data/projects';

const { frontmatter, headings = [], url } = Astro.props;
const f = frontmatter;

// Section links for long case studies (set "toc: true" in the case study).
const sections = f.toc ? headings.filter((h: any) => h.depth === 2) : [];

// The next case study in the site's order, wrapping round to the first.
const i = projects.findIndex((p: any) => p.url === url);
const next = projects[(i + 1) % projects.length];
---

<BaseLayout title={`${f.title}, Badal Ranjan`} description={f.summary}>
  <article class="wrap">
    <header class="page-head">
      <p class="eyebrow">{f.category}</p>
      <h1>{f.title}</h1>
      <p class="lede">{f.headline ?? f.summary}</p>
    </header>

    <dl class="facts">
      <div><dt>Company</dt><dd>{f.company}</dd></div>
      <div><dt>Period</dt><dd>{f.period}</dd></div>
      <div><dt>Role</dt><dd>{f.role}</dd></div>
      <div><dt>Tools</dt><dd>{f.tools}</dd></div>
    </dl>

    <div class="case-cover">
      <Cover project={f} eager />
    </div>

    <div class={sections.length ? 'case-body has-toc' : 'case-body'}>
      {
        sections.length > 0 && (
          <nav class="toc" aria-label="Sections in this case study">
            <p class="toc-head">On this page</p>
            <ol>
              {sections.map((h: any) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}
            </ol>
          </nav>
        )
      }
      <div class="prose">
        <slot />
      </div>
    </div>

    <nav class="next" aria-label="Case studies">
      <a href="/#work">All work</a>
      {next && next.url !== url && (
        <a class="next-link" href={next.url}>
          <span class="muted">Next case study</span>
          <span class="next-title">{next.title}</span>
        </a>
      )}
    </nav>
  </article>
</BaseLayout>
